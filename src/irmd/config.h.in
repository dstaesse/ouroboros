#define _B "[38;5;4m"
#define _G "[38;5;8m"
#define RST "[0m"

#define O7S_ASCII_ART \
RST "\n" \
_B "    ▄▄█████▄▄▄                                                   \n" \
_B "  ▄█▀▀     ▀▀███▄  " _G "                █                       \n" \
_B " ██    ▄▄▄   ▄███▄ " _G "▄  ▄  ▄ ▄   ▄▄  █▄▄   ▄▄  ▄ ▄   ▄▄   ▄▄ \n" \
_B " ██   █   █  █████ " _G "█  █  █▀ ▀ █  █ █  █ █  █ █▀ ▀ █  █ ▀▄ ▀\n" \
_B " ██   ▀▄▄▄▀   ▀█▀  " _G "█  █  █    █  █ █  █ █  █ █    █  █ ▄ ▀▄\n" \
_B "  █▄          █    " _G " ▀▀ ▀ ▀     ▀▀  ▀▀▀   ▀▀  ▀     ▀▀   ▀▀ \n" \
_B "   ▀█▄▄▄▄▄▄▄▄▀                                                   \n" \
_B "     ▀▀▀▀▀▀                                                      \n" \
RST "\n"
